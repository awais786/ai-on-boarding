# Copy to .env and fill in. Every value here has a localhost-friendly
# default in config.py except the Google credentials, which are required.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL this server is reached at. Must match a redirect URI registered
# in the Google OAuth app as "{MCP_BASE_URL}/auth/callback".
MCP_BASE_URL=http://localhost:8100

# Django API base this server calls.
BACKEND_API_BASE=http://localhost:8000/api
