{
  "capability": "user-password-reset",
  "entries": [
    {
      "operationId": "password_reset_create",
      "variant": "success",
      "requirement": "Accept a reset request",
      "test": [
        "pm.test('Accept a reset request', function () {",
        "    pm.response.to.have.status(200);",
        "});",
        "pm.collectionVariables.set('resetRequestBody', pm.response.text());"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "success",
      "requirement": "Answer every reset request identically",
      "test": [
        "pm.test('Reset request response shape', function () {",
        "    pm.response.to.have.status(200);",
        "});"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "success",
      "requirement": "Never return the reset code in a response",
      "test": [
        "pm.test('Never return the reset code in a response', function () {",
        "    pm.expect(Object.keys(pm.response.json())).to.eql(['detail']);",
        "});"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "missing_email",
      "requirement": "Reject a reset request with no email",
      "test": [
        "pm.test('Reject a reset request with no email', function () {",
        "    pm.response.to.have.status(400);",
        "    pm.expect(pm.response.json()).to.have.property('email');",
        "});"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "unregistered_initial",
      "requirement": "Answer every reset request identically",
      "test": [
        "pm.test('Registered and unregistered addresses are indistinguishable', function () {",
        "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('resetRequestBody'));",
        "});"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "fixture_throttled",
      "requirement": "Limit how often a reset may be requested for one address",
      "test": [
        "pm.test('Limit how often a reset may be requested for one address (fixture)', function () {",
        "    pm.response.to.have.status(429);",
        "    pm.expect(Object.keys(pm.response.json())).to.eql(['detail']);",
        "    pm.expect(pm.response.headers.has('Retry-After')).to.be.false;",
        "});",
        "pm.collectionVariables.set('resetThrottleBodyFixture', pm.response.text());"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "unreg_throttled",
      "requirement": "Limit how often a reset may be requested for one address",
      "test": [
        "pm.test('Limit how often a reset may be requested for one address (unregistered)', function () {",
        "    pm.response.to.have.status(429);",
        "    pm.expect(pm.response.headers.has('Retry-After')).to.be.false;",
        "});"
      ]
    },
    {
      "operationId": "password_reset_create",
      "variant": "unreg_throttled",
      "requirement": "Limit how often a reset may be requested for one address",
      "test": [
        "pm.test('Reaching the limit does not reveal whether an account exists', function () {",
        "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('resetThrottleBodyFixture'));",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "weak_password",
      "requirement": "Accept a reset completion",
      "test": [
        "pm.test('Accept a reset completion (proceeds to field validation)', function () {",
        "    pm.response.to.have.status(400);",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "weak_password",
      "requirement": "Hold a new password to the signup strength rules",
      "test": [
        "pm.test('Weak new password is rejected', function () {",
        "    pm.response.to.have.status(400);",
        "    pm.expect(pm.response.json()).to.have.property('password');",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "weak_password",
      "requirement": "Hold a new password to the signup strength rules",
      "test": [
        "pm.test('The account keeps its old password after a rejected completion', function () {",
        "    return new Promise(function (resolve, reject) {",
        "        pm.sendRequest({",
        "            url: pm.variables.replaceIn('{{baseUrl}}/api/signin/'),",
        "            method: 'POST',",
        "            header: { 'Content-Type': 'application/json' },",
        "            body: {",
        "                mode: 'raw',",
        "                raw: JSON.stringify({",
        "                    email_or_username: 'conformance-fixture@example.com',",
        "                    password: 'Fixture1pw'",
        "                })",
        "            }",
        "        }, function (err, response) {",
        "            if (err) { return reject(err); }",
        "            try {",
        "                pm.expect(response.code).to.eql(200);",
        "                resolve();",
        "            } catch (assertionError) { reject(assertionError); }",
        "        });",
        "    });",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "bad_code_1",
      "requirement": "Return HTTP 400 when a reset completion is refused",
      "test": [
        "pm.test('Return HTTP 400 when a reset completion is refused', function () {",
        "    pm.response.to.have.status(400);",
        "});",
        "pm.collectionVariables.set('resetBadCodeBody', pm.response.text());"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "bad_code_1",
      "requirement": "Never return a password",
      "test": [
        "pm.test('Never return a password (reset confirm)', function () {",
        "    pm.expect(pm.response.text()).to.not.include('Whatever123');",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "bad_code_2",
      "requirement": "Reject every bad code identically",
      "test": [
        "pm.test('Reject every bad code identically (two unrecognised codes) - only the unrecognised-code cause is exercised live; expired/used/superseded need a real code, see out_of_scope.json', function () {",
        "    pm.response.to.have.status(400);",
        "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('resetBadCodeBody'));",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "missing_code",
      "requirement": "Reject a reset completion with missing fields",
      "test": [
        "pm.test('Reject a reset completion with missing fields (code omitted)', function () {",
        "    pm.response.to.have.status(400);",
        "    pm.expect(pm.response.json()).to.have.property('code');",
        "});"
      ]
    },
    {
      "operationId": "password_reset_confirm_create",
      "variant": "missing_password",
      "requirement": "Reject a reset completion with missing fields",
      "test": [
        "pm.test('Reject a reset completion with missing fields (password omitted)', function () {",
        "    pm.response.to.have.status(400);",
        "    pm.expect(pm.response.json()).to.have.property('password');",
        "});"
      ]
    }
  ]
}
