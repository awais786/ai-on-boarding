{
  "capability": "user-signin",
  "entries": [
    {
      "operationId": "signin_create",
      "variant": "success",
      "requirement": "Accept a signin submission",
      "test": [
        "pm.test('Accept a signin submission', function () {",
        "    pm.response.to.have.status(200);",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "success",
      "requirement": "Succeed with correct credentials",
      "test": [
        "pm.test('Succeed with correct credentials', function () {",
        "    pm.response.to.have.status(200);",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "success",
      "requirement": "Signal success with an authentication token",
      "test": [
        "pm.test('Signal success with an authentication token', function () {",
        "    const body = pm.response.json();",
        "    pm.expect(body).to.have.property('token');",
        "    pm.expect(body.token).to.be.a('string').and.not.empty;",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "success",
      "requirement": "Never return the password",
      "test": [
        "pm.test('Never return the password (signin success)', function () {",
        "    pm.expect(pm.response.text()).to.not.include('Fixture1pw');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "success_repeat",
      "requirement": "Succeed with correct credentials",
      "test": [
        "pm.test('Repeated signin with the same credentials succeeds again', function () {",
        "    pm.response.to.have.status(200);",
        "    pm.expect(pm.response.json()).to.have.property('token');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "case_insensitive",
      "requirement": "Authenticate against the matching account",
      "test": [
        "pm.test('Authenticate against the matching account (case-insensitive email)', function () {",
        "    pm.response.to.have.status(200);",
        "    pm.expect(pm.response.json()).to.have.property('token');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "case_insensitive_username",
      "requirement": "Authenticate against the matching account",
      "test": [
        "pm.test('Authenticate against the matching account (case-insensitive username)', function () {",
        "    pm.response.to.have.status(200);",
        "    pm.expect(pm.response.json()).to.have.property('token');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "missing_password",
      "requirement": "Reject a missing password",
      "test": [
        "pm.test('Reject a missing password (signin)', function () {",
        "    pm.response.to.have.status(401);",
        "    pm.expect(pm.response.json()).to.have.property('password');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "missing_identifier",
      "requirement": "Reject a missing email",
      "test": [
        "pm.test('Reject a missing email or username (signin)', function () {",
        "    pm.response.to.have.status(401);",
        "    pm.expect(pm.response.json()).to.have.property('email_or_username');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "unregistered",
      "requirement": "Reject an unregistered email",
      "test": [
        "pm.test('Reject an unregistered email', function () {",
        "    pm.response.to.have.status(401);",
        "});",
        "pm.collectionVariables.set('signinRejectionBody', pm.response.text());"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "unregistered",
      "requirement": "Return HTTP 401 on rejection",
      "test": [
        "pm.test('Return HTTP 401 on rejection (unregistered email)', function () {",
        "    pm.response.to.have.status(401);",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "wrong_password",
      "requirement": "Reject an incorrect password",
      "test": [
        "pm.test('Reject an incorrect password', function () {",
        "    pm.response.to.have.status(401);",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "wrong_password",
      "requirement": "Reject all failure modes identically",
      "test": [
        "pm.test('Reject all failure modes identically (unregistered vs wrong password)', function () {",
        "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('signinRejectionBody'));",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "wrong_password",
      "requirement": "Never return the password",
      "test": [
        "pm.test('Never return the password (signin rejection)', function () {",
        "    pm.expect(pm.response.text()).to.not.include('WrongPassw0rd');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "lockout_correct_password",
      "requirement": "Lock an email out after repeated failures",
      "test": [
        "pm.test('Lock an email out after repeated failures (third failure triggers lockout)', function () {",
        "    pm.response.to.have.status(401);",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "lockout_correct_password",
      "requirement": "Reject all failure modes identically",
      "test": [
        "pm.test('Reject all failure modes identically (lockout vs wrong password)', function () {",
        "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('signinRejectionBody'));",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "resetcount_verify",
      "requirement": "Reset the failure count on success",
      "test": [
        "pm.test('Reset the failure count on success', function () {",
        "    pm.response.to.have.status(200);",
        "    pm.expect(pm.response.json()).to.have.property('token');",
        "});"
      ]
    },
    {
      "operationId": "signin_create",
      "variant": "lockout_mixed_verify",
      "requirement": "Lock an email out after repeated failures",
      "test": [
        "pm.test('Lock an email out after repeated failures (lockout applies across email and username)', function () {",
        "    pm.response.to.have.status(401);",
        "});"
      ]
    }
  ]
}
